rules_version = '2';

// Access model (ported from the original Supabase RLS, supabase/migrations):
//
//   team member  a signed-in user whose VERIFIED email has a document in
//                allowed_emails (document ID = the lowercase email).
//                Mirrors is_team_member(). Signing in never grants access.
//   admin        a team member with user_roles/{uid}.role == 'admin'.
//   manager      role 'manager' (or admin): may delete program data and edit
//                taxonomy, as can_manage() allowed.
//
// Server code (server functions, scheduled hooks, the seed script) uses the
// Admin SDK, which bypasses these rules. Collections that only the server
// touches are denied to every client below.
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: anything not matched below is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email/password accounts start unverified, so a stranger who registers
    // someone else's address with a password gets nothing until it is verified.
    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function allowlistPath(email) {
      return /databases/$(database)/documents/allowed_emails/$(email);
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/user_roles/$(uid);
    }

    function isTeamMember() {
      return hasVerifiedEmail()
        && exists(allowlistPath(request.auth.token.email.lower()));
    }

    function hasRole(roles) {
      return isTeamMember()
        && exists(rolePath(request.auth.uid))
        && get(rolePath(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    // can_manage() in the original schema: admin or manager.
    function canManage() {
      return hasRole(['admin', 'manager']);
    }

    function isKnownRole(role) {
      return role in ['admin', 'manager', 'contributor', 'viewer'];
    }

    // ------------------------------------------------------- people & access

    // Everyone on the team can see everyone; people may only create and edit
    // their own row, and never change who it belongs to or its email.
    match /profiles/{userId} {
      allow read: if isTeamMember();
      allow create: if isTeamMember()
        && isOwner(userId)
        && isValidId(userId)
        && request.resource.data.keys().hasOnly(
          ['id', 'email', 'full_name', 'title', 'avatar_url', 'created_at', 'updated_at'])
        && request.resource.data.id == userId
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if isTeamMember()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'title', 'avatar_url', 'updated_at']);
      allow delete: if false;
    }

    // The allowlist. Anyone signed in can ask "is MY address on it?" (the sign-in
    // screen does); only team members can list it; only admins change it.
    match /allowed_emails/{emailId} {
      allow get: if isTeamMember()
        || (hasVerifiedEmail() && emailId == request.auth.token.email.lower());
      allow list: if isTeamMember();
      allow create, update: if isAdmin()
        && emailId.matches('^[^/@\\s]+@[^/@\\s]+$')
        && emailId == emailId.lower()
        && request.resource.data.email == emailId;
      allow delete: if isAdmin();
    }

    // One role document per user, keyed by uid. Admin-only writes: this is the
    // only place privilege lives, and profiles cannot carry role fields.
    match /user_roles/{uid} {
      allow read: if isTeamMember();
      allow create, update: if isAdmin()
        && isValidId(uid)
        && request.resource.data.user_id == uid
        && isKnownRole(request.resource.data.role);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------- program data
    // Team members read, create and edit. Deleting is for managers and admins.

    match /opportunities/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /opportunity_dates/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /opportunity_cycles/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /opportunity_changes/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /submissions/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /submission_fields/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /submission_speakers/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /submission_briefs/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /submission_answer_versions/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /brief_items/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /proof_points/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /content_assets/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /content_snippets/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /speakers/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    match /discoveries/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if isTeamMember();
      allow delete: if canManage();
    }

    // Monitoring checks are an append-only log (no update policy originally).
    match /monitoring_checks/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember() && isValidId(id);
      allow update: if false;
      allow delete: if canManage();
    }

    // Audit trail: members append entries attributed to themselves; nobody
    // edits or erases history from a client.
    match /activity_log/{id} {
      allow read: if isTeamMember();
      allow create: if isTeamMember()
        && isValidId(id)
        && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Configurable status/priority/etc. lists: everyone reads, managers edit.
    match /taxonomy_options/{id} {
      allow read: if isTeamMember();
      allow create: if canManage() && isValidId(id);
      allow update: if canManage();
      allow delete: if canManage();
    }

    // -------------------------------------------------------- per-user data
    // Private to the owning user. Clients must query with
    // where('user_id', '==', uid), which the data layer does for them.

    match /notifications/{id} {
      allow read, update, delete: if isTeamMember() && resource.data.user_id == request.auth.uid;
      allow create: if isTeamMember()
        && isValidId(id)
        && request.resource.data.user_id == request.auth.uid;
    }

    match /saved_views/{id} {
      allow read, update, delete: if isTeamMember() && resource.data.user_id == request.auth.uid;
      allow create: if isTeamMember()
        && isValidId(id)
        && request.resource.data.user_id == request.auth.uid;
    }

    // ------------------------------------------------- server-only collections
    // Reached only through the Admin SDK (which bypasses rules). Explicit
    // matches so the intent survives anyone loosening the catch-all above.

    // Per-job shared secrets for the scheduled hooks and the calendar feed.
    match /job_secrets/{id} {
      allow read, write: if false;
    }

    // Single-flight/run markers for scheduled hooks.
    match /webhook_runs/{id} {
      allow read, write: if false;
    }

    // Idempotency log so each digest email is sent once.
    match /email_digest_log/{id} {
      allow read, write: if false;
    }

    // OAuth refresh tokens for integrations (Google Drive). Never client-readable.
    match /integration_tokens/{id} {
      allow read, write: if false;
    }
  }
}
