# Google AI Studio / Gemini API (native alternative to Lovable AI)
GEMINI_API_KEY=

# Application URL (optional, defaults to current Cloud Run URL)
APP_URL=

# Google Drive API (optional, for Drive asset and tracker sync)
GOOGLE_DRIVE_API_KEY=

# Digest & Notification Emails (optional)
DISCOVER_ALIAS_EMAIL=
EMAIL_FROM_ADDRESS=
TEAM_ALIAS_EMAIL=

# Webhook Secret for Cron Tasks (optional)
MONITOR_WEBHOOK_SECRET=
